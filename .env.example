# Copy to .env. Local runs: ENV_FILE=.env npm start. Docker: mounted at /run/secrets/media-hub.env.
# Keep it private (chmod 600): it holds the admin password and possibly the Jellyfin API key.
# Everything but ADMIN_PASSWORD can also be set from the admin page, which wins over these.
ADMIN_PASSWORD=change-me
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
JELLYFIN_USER=
